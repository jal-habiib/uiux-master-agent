OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_CAPABILITIES=text,vision,tool_calling,json_output
OPENROUTER_TIMEOUT=30
OPENROUTER_PRIORITY=10
OPENROUTER_ENABLED=true

NVIDIA_API_KEY=your-nvidia-key
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_CAPABILITIES=text,tool_calling
NVIDIA_TIMEOUT=30
NVIDIA_PRIORITY=20
NVIDIA_ENABLED=true

# Optional provider examples. Keep capabilities limited to what the selected
# model actually supports; missing capabilities disable routing to that model.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CAPABILITIES=text,tool_calling
GROQ_TIMEOUT=30
GROQ_PRIORITY=30
GROQ_ENABLED=true

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_CAPABILITIES=text,vision,tool_calling,json_output
GEMINI_TIMEOUT=30
GEMINI_PRIORITY=40
GEMINI_ENABLED=true

# Use only capabilities explicitly supported by the configured model.
MAX_ITER=20